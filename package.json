{
  "name": "nativr-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "NativR browser-native R-compatible runtime monorepo",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nativr/nativr.git"
  },
  "homepage": "https://github.com/nativr/nativr#readme",
  "bugs": {
    "url": "https://github.com/nativr/nativr/issues"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "node scripts/build.mjs",
    "build:packages": "tsc -b",
    "clean": "node scripts/clean.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "lint": "eslint .",
    "boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:all": "node scripts/test-all.mjs",
    "grammar:build": "node scripts/build-r-grammar.mjs",
    "conformance": "node scripts/run-conformance.mjs",
    "conformance:r": "node scripts/run-r-conformance.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "pack:smoke": "node scripts/smoke-pack.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "audit:browser": "node scripts/audit-browser-bundle.mjs",
    "check": "node scripts/check.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm pack:smoke -- --skip-build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@davisvaughan/tree-sitter-r": "1.3.0",
    "@eslint/js": "10.0.1",
    "@microsoft/api-extractor": "7.58.12",
    "@playwright/test": "1.62.0",
    "@types/node": "26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "fast-check": "4.9.0",
    "globals": "17.8.0",
    "prettier": "3.9.6",
    "tree-sitter-cli": "0.26.11",
    "typescript": "7.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vite-plugin-dts": "5.0.3",
    "vitest": "4.1.10",
    "web-tree-sitter": "0.26.11"
  }
}
