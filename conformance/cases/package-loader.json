[
  {
    "id": "namespace-export-pattern-posix-classes",
    "packages": [
      {
        "description": "Package: posixpattern\nVersion: 1.0.0",
        "namespace": "exportPattern(\"^[[:alpha:]][[:alnum:]_.]*$\")",
        "rSources": [
          {
            "path": "R/values.R",
            "source": "visible <- 42L\nA2 <- 43L\n.hidden <- 99L"
          }
        ]
      }
    ],
    "code": "c(sort(getNamespaceExports(\"posixpattern\")), as.character(posixpattern::A2), as.character(posixpattern::visible))",
    "expected": ["A2", "visible", "43", "42"],
    "expectedCompatibility": "behavioral",
    "tolerance": {
      "absolute": 0,
      "relative": 0
    },
    "rOracle": false
  },
