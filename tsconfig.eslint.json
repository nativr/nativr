{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "WebWorker"],
    "types": ["node", "vitest/globals", "@playwright/test"],
    "paths": {
      "@nativr/ast": ["./packages/ast/src/index.ts"],
      "@nativr/base": ["./packages/base/src/index.ts"],
      "@nativr/parser": ["./packages/parser/src/index.ts"],
      "@nativr/protocol": ["./packages/protocol/src/index.ts"],
      "@nativr/runtime": ["./packages/runtime/src/index.ts"],
      "@nativr/nativr": ["./packages/nativr/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
